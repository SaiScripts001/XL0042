{
  "name": "hackxelrate-health-copilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-Powered Personal Health Copilot — OCR, plain-language AI health summaries, unified timeline, nearby hospitals, multi-language.",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "pdfjs-dist": "^4.8.69",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
