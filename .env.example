# -- Groq API ---------------------------------------------------------------
# Get a free key at https://console.groq.com/keys -> paste it below, then restart the server.
GROQ_API_KEY=gsk_your_key_here

# -- BACKUP KEYS (recommended for demos!) --------------------------------
# Each free Groq key = 200K tokens/day. Paste extra keys here - the
# server round-robins across ALL keys and auto-fails-over when one is
# rate-limited (429) or invalid (401/403). Comma-separated here, or
# one per line as GROQ_API_KEY_2, GROQ_API_KEY_3 ... up to _10.
GROQ_API_KEYS=

# -- Google Places (OPTIONAL - for live ratings & reviews on the Hospitals map) --
# Get a key at https://console.cloud.google.com/apis/library/places.googleapis.com
# Enable "Places API (New)". Without it, the map uses OpenStreetMap data (no ratings).
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY_HERE

# Optional overrides (current Groq free-tier models - Llama 3.1/3.3 and Llama-4 Scout
# were moved to Enterprise, so free keys must use these instead)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# Backup TEXT models - Groq enforces quotas PER MODEL, so a second model
# keeps the assistant working even when the preferred model's daily limit
# is exhausted. Tried in order when the first one returns 429.
GROQ_TEXT_FALLBACKS=allam-2-7b,qwen/qwen3.8-27b
PORT=3001
